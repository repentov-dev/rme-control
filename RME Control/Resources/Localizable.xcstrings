    "TotalMix reported these inputs and outputs. Select the ones you want to control. You can change them later in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix сообщил эти входы и выходы. Отметьте те, которыми хотите управлять. Позже их можно изменить в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix meldet diese Ein- und Ausgänge. Wählen Sie die aus, die Sie steuern möchten. Später lässt sich das in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix a signalé ces entrées et sorties. Sélectionnez celles que vous voulez contrôler. Vous pourrez les modifier plus tard dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix informó de estas entradas y salidas. Seleccione las que quiera controlar. Podrá cambiarlas más tarde en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix ha riportato questi ingressi e uscite. Seleziona quelli che vuoi controllare. Potrai modificarli più tardi nelle impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O TotalMix comunicou estas entradas e saídas. Selecione as que quer controlar. Pode alterá-las mais tarde nas definições."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix meldde deze in- en uitgangen. Selecteer degene die je wilt bedienen. Je kunt ze later in Instellingen wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix zgłosił te wejścia i wyjścia. Zaznacz te, którymi chcesz sterować. Później możesz je zmienić w ustawieniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix повідомив ці входи й виходи. Позначте ті, якими хочете керувати. Пізніше їх можна змінити в налаштуваннях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix bu giriş ve çıkışları bildirdi. Denetlemek istediklerinizi seçin. Daha sonra ayarlarda değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix 报告了这些输入和输出。选择您想控制的项目。稍后可在设置中更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix がこれらの入出力を報告しました。操作したいものを選択してください。後で設定から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix가 이 입력과 출력을 보고했습니다. 제어할 항목을 선택하십시오. 나중에 설정에서 변경할 수 있습니다."
          }
        }
      }
    },
    "You're all set": {
      "localizations": {
        "ru": {
