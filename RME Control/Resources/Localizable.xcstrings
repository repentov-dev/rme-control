    "A mute button for every output.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка Mute для каждого выхода."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mute-Taste für jeden Ausgang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton muet pour chaque sortie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón de silencio para cada salida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pulsante mute per ogni uscita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão mudo para cada saída."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een mute-knop voor elke uitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk wyciszenia dla każdego wyjścia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка відключення звуку для кожного виходу."
