          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 麦克风中允许。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → マイク で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
