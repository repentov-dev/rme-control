          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채널은 메뉴 막대 패널에서 사용할 수 있습니다."
          }
        }
      }
    },
    "No channels added yet. You can scan them later in Settings → Channels.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каналы пока не добавлены. Их можно найти позже в разделе «Настройки → Каналы»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kanäle hinzugefügt. Sie lassen sich später unter Einstellungen → Kanäle suchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun canal ajouté pour l'instant. Vous pourrez les analyser plus tard dans Réglages → Canaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han añadido canales. Podrá buscarlos más tarde en Ajustes → Canales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun canale aggiunto. Potrai cercarli più tardi in Impostazioni → Canali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foram adicionados canais. Pode procurá-los mais tarde em Definições → Canais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen kanalen toegevoegd. Je kunt ze later zoeken in Instellingen → Kanalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dodano jeszcze kanałów. Możesz je znaleźć później w Ustawienia → Kanały."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Канали ще не додано. Їх можна знайти пізніше в «Налаштування → Канали»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kanal eklenmedi. Daha sonra Ayarlar → Kanallar bölümünde tarayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未添加通道。稍后可在设置 → 通道中扫描。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルがまだ追加されていません。後で「設定 → チャンネル」からスキャンできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 채널이 추가되지 않았습니다. 나중에 설정 → 채널에서 스캔할 수 있습니다."
          }
        }
      }
    },
    "RME Control needs this permission to intercept the hardware keys.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разрешение нужно RME Control, чтобы перехватывать аппаратные клавиши."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control braucht diese Berechtigung, um die Hardware-Tasten abzufangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control a besoin de cette autorisation pour intercepter les touches physiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control necesita este permiso para interceptar las teclas físicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control ha bisogno di questo permesso per intercettare i tasti hardware."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O RME Control precisa desta permissão para intercetar as teclas físicas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control heeft deze toestemming nodig om de hardwaretoetsen af te vangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control potrzebuje tego uprawnienia, aby przechwytywać klawisze sprzętowe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control потрібен цей дозвіл, щоб перехоплювати апаратні клавіші."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control'ün donanım tuşlarını yakalamak için bu izne ihtiyacı var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control 需要此权限来拦截硬件按键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control がハードウェアキーを横取りするにはこの権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control이 하드웨어 키를 가로채려면 이 권한이 필요합니다."
          }
        }
      }
    },
