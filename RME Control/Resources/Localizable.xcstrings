    "Mute the selected output, or toggle Dim — see the hardware keys below.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить звук выбранного выхода или переключить Dim — см. аппаратные клавиши ниже."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gewählten Ausgang stummschalten oder Dim umschalten — siehe Hardware-Tasten unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper le son de la sortie sélectionnée ou basculer Dim — voir les touches physiques ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar la salida seleccionada o alternar Dim; consulte las teclas físicas más abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muta l'uscita selezionata o attiva/disattiva Dim — vedi i tasti hardware qui sotto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar a saída selecionada ou alternar Dim — ver as teclas físicas abaixo."
          }
        },
        "nl": {
