    "Run a full measurement before calculating a correction.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выполните полный замер, потом считайте коррекцию."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie zuerst eine vollständige Messung durch, bevor Sie eine Korrektur berechnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une mesure complète avant de calculer une correction."
