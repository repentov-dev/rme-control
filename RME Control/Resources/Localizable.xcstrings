    },
    "TotalMix reported these inputs and outputs. Select the ones you want to control. You can change them later in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix сообщил эти входы и выходы. Отметьте те, которыми хотите управлять. Позже их можно изменить в настройках."
          }
        }
      }
    },
    "You're all set": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё готово"
          }
        }
      }
    },
    "RME Control is ready to use.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RME Control готов к работе."
          }
        }
      }
    },
    "These channels will be available in the menu bar panel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти каналы будут доступны в панели из строки меню."
          }
        }
      }
    },
    "No channels added yet. You can scan them later in Settings → Channels.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каналы пока не добавлены. Их можно найти позже в разделе «Настройки → Каналы»."
          }
        }
      }
    },
    "RME Control needs this permission to intercept the hardware keys.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разрешение нужно RME Control, чтобы перехватывать аппаратные клавиши."
          }
        }
      }
    },
