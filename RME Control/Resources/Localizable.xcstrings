    "OSC addresses for the Speaker B, Dim and Mono buttons. Change them only if your TotalMix setup uses different addresses.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OSC-адреса кнопок Speaker B, Dim и Mono. Меняйте их, только если в вашем TotalMix используются другие адреса."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OSC-Adressen für die Tasten „Speaker B“, „Dim“ und „Mono“. Ändern Sie sie nur, wenn Ihr TotalMix-Setup andere Adressen verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses OSC pour les boutons Speaker B, Dim et Mono. Modifiez-les uniquement si votre configuration TotalMix utilise des adresses différentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones OSC para los botones Speaker B, Dim y Mono. Cámbielos sólo si su configuración de TotalMix utiliza direcciones diferentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzi OSC per i pulsanti Altoparlante B, Dim e Mono. Cambiali solo se la tua configurazione TotalMix utilizza indirizzi diversi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereços OSC para os botões Speaker B, Dim e Mono. Altere-os somente se a configuração do TotalMix usar endereços diferentes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OSC-adressen voor de knoppen Speaker B, Dim en Mono. Wijzig ze alleen als uw TotalMix-installatie verschillende adressen gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresy OSC dla przycisków Głośnik B, Dim i Mono. Zmień je tylko wtedy, gdy konfiguracja TotalMix używa różnych adresów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреси OSC для кнопок Speaker B, Dim і Mono. Змінюйте їх, лише якщо ваші налаштування TotalMix використовують інші адреси."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoparlör B, Dim ve Mono düğmelerinin OSC adresleri. Bunları yalnızca TotalMix kurulumunuz farklı adresler kullanıyorsa değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扬声器 B、调暗和单声道按钮的 OSC 地址。仅当您的 TotalMix 设置使用不同的地址时才更改它们。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker B、Dim、Mono ボタンの OSC アドレス。 TotalMix セットアップで異なるアドレスが使用されている場合にのみ、それらを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스피커 B, Dim 및 Mono 버튼에 대한 OSC 주소입니다. TotalMix 설정이 다른 주소를 사용하는 경우에만 변경하십시오."
          }
        }
      }
    },
