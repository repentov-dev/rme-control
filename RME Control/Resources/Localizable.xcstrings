    "TotalMix did not answer. Check that TotalMix FX is running and its global OSC is enabled.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix не ответил. Проверьте, что TotalMix FX запущен и в нём включён глобальный OSC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix hat nicht geantwortet. Prüfen Sie, ob TotalMix FX läuft und globales OSC aktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix n'a pas répondu. Vérifiez que TotalMix FX est lancé et que l'OSC global est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix no respondió. Compruebe que TotalMix FX se esté ejecutando y que su OSC global esté activado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix non ha risposto. Controlla che TotalMix FX sia in esecuzione e che l'OSC globale sia attivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O TotalMix não respondeu. Verifique se o TotalMix FX está a correr e se o OSC global está ativo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix antwoordde niet. Controleer of TotalMix FX draait en of de globale OSC is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix nie odpowiedział. Sprawdź, czy TotalMix FX działa i czy globalny OSC jest włączony."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix не відповів. Перевірте, чи запущено TotalMix FX і чи ввімкнено глобальний OSC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix yanıt vermedi. TotalMix FX'in çalıştığını ve genel OSC'nin açık olduğunu denetleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix 未响应。请检查 TotalMix FX 是否在运行并已启用全局 OSC。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix が応答しません。TotalMix FX が起動していて、グローバル OSC が有効か確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TotalMix가 응답하지 않습니다. TotalMix FX가 실행 중이고 전역 OSC가 켜져 있는지 확인하십시오."
          }
        }
      }
    },
