          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölç içinde başka bir kanal seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在测量中选择其他通道。"
          }
        },
        "ja": {
