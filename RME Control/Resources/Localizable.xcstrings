            "value": "Ripristinare le scorciatoie predefinite?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor os atalhos predefinidos?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneltoetsen naar standaardwaarden herstellen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócić domyślne skróty?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити типові гарячі клавіші?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar varsayılana dönsün mü?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将快捷键恢复为默认值？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットをデフォルトに戻しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 기본값으로 복원하시겠습니까?"
          }
        }
      }
    },
    "Only the keyboard shortcuts are reset. Channels, presets and other settings stay as they are.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросятся только сочетания клавиш. Каналы, пресеты и остальные настройки останутся как есть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgesetzt werden nur die Tastaturkürzel. Kanäle, Voreinstellungen und andere Einstellungen bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les raccourcis clavier sont réinitialisés. Les canaux, préréglages et autres réglages restent inchangés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se restablecen los atajos de teclado. Los canales, preajustes y demás ajustes no cambian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono reimpostate solo le scorciatoie da tastiera. Canali, preset e altre impostazioni restano come sono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os atalhos de teclado são repostos. Canais, predefinições e outras definições ficam como estão."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de toetsenbordsneltoetsen worden hersteld. Kanalen, voorinstellingen en andere instellingen blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetowane są tylko skróty klawiszowe. Kanały, ustawienia wstępne i inne ustawienia pozostają bez zmian."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидаються лише сполучення клавіш. Канали, пресети та інші налаштування залишаються як є."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca klavye kısayolları sıfırlanır. Kanallar, ön ayarlar ve diğer ayarlar olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会重置键盘快捷键。通道、预设和其他设置保持不变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットされるのはキーボードショートカットだけです。チャンネル、プリセット、その他の設定はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 단축키만 재설정됩니다. 채널, 프리셋 및 기타 설정은 그대로 유지됩니다."
          }
        }
      }
    },
    "Hardware keys": {
      "localizations": {
