    },
    "Allow it in System Settings → Privacy & Security → Microphone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ в «Системные настройки» → «Конфиденциальность и безопасность» → «Микрофон»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Zugriff unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez-le dans Réglages Système → Confidentialité et sécurité → Micro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítalo en Ajustes del Sistema → Privacidad y seguridad → Micrófono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentilo in Impostazioni di Sistema → Privacy e sicurezza → Microfono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita-o em Definições do Sistema → Privacidade e segurança → Microfone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta het toe in Systeeminstellingen → Privacy en beveiliging → Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na to w Ustawieniach systemowych → Prywatność i bezpieczeństwo → Mikrofon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте це в «Системні налаштування» → «Конфіденційність і безпека» → «Мікрофон»."
          }
        },
        "tr": {
