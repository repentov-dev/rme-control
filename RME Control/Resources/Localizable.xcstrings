    "Quit other audio apps, check the cable, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте другие аудиоприложения, проверьте кабель и попробуйте снова."
          }
        },
        "de": {
