    "Left, Right and Stereo are calculated at once. This usually takes a few seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Левый, правый и стерео рассчитываются сразу. Обычно это занимает несколько секунд."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, rechts und Stereo werden auf einmal berechnet. Das dauert meist einige Sekunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauche, droite et stéréo sont calculés d'un coup. Cela prend en général quelques secondes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Izquierda, derecha y estéreo se calculan a la vez. Suele tardar unos segundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinistra, destra e stereo vengono calcolati insieme. Di solito richiede qualche secondo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquerda, direita e estéreo são calculados de uma vez. Normalmente demora alguns segundos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, rechts en stereo worden in één keer berekend. Dat duurt meestal een paar seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewy, prawy i stereo są obliczane naraz. Zwykle zajmuje to kilka sekund."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лівий, правий і стерео обчислюються одразу. Зазвичай це кілька секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol, sağ ve stereo birlikte hesaplanır. Genelde birkaç saniye sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左、右和立体声会同时计算。通常需要几秒钟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左、右、ステレオは一度に計算されます。通常数秒かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽, 오른쪽, 스테레오가 한 번에 계산됩니다. 보통 몇 초 걸립니다."
          }
        }
      }
