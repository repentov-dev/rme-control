          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェースを接続して測定を開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스를 연결하고 측정을 다시 여십시오."
          }
        }
      }
    },
    "Choose another channel in Measure.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите другой канал в Measure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in Messen einen anderen Kanal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un autre canal dans Mesurer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija otro canal en Medir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un altro canale in Misura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha outro canal em Medir."
          }
        },
        "nl": {
