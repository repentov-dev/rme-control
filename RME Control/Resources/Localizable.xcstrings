    "Run the assistant again to scan channels, check permissions and choose startup options.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова запустить мастер: найти каналы, проверить разрешения и выбрать параметры запуска."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Assistenten erneut ausführen, um Kanäle zu suchen, Berechtigungen zu prüfen und Startoptionen zu wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancer l'assistant pour analyser les canaux, vérifier les autorisations et choisir les options de démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar de nuevo el asistente para buscar canales, comprobar permisos y elegir las opciones de inicio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui di nuovo l'assistente per cercare i canali, controllare i permessi e scegliere le opzioni di avvio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar novamente o assistente para procurar canais, verificar permissões e escolher as opções de arranque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de assistent opnieuw uit om kanalen te zoeken, rechten te controleren en opstartopties te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom asystenta ponownie, aby znaleźć kanały, sprawdzić uprawnienia i wybrać opcje startu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть майстер знову, щоб знайти канали, перевірити дозволи й вибрати параметри запуску."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalları bulmak, izinleri denetlemek ve başlangıç seçeneklerini belirlemek için asistanı yeniden çalıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次运行助手以扫描通道、检查权限并选择启动选项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルのスキャン、権限の確認、起動オプションの選択のため、アシスタントをもう一度実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채널을 스캔하고 권한을 확인하며 시작 옵션을 선택하려면 도우미를 다시 실행하십시오."
          }
        }
      }
    },
