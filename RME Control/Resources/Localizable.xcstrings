    "Use Option + Up/Down to choose the output controlled by the volume keys.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирать выход, управляемый клавишами громкости, сочетанием Option + ↑/↓."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den von den Lautstärketasten gesteuerten Ausgang mit Option + ↑/↓ wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir avec Option + ↑/↓ la sortie contrôlée par les touches de volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir con Opción + ↑/↓ la salida controlada por las teclas de volumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli con Opzione + ↑/↓ l’uscita controllata dai tasti volume."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher com Option + ↑/↓ a saída controlada pelas teclas de volume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies met Option + ↑/↓ de uitgang die door de volumetoetsen wordt bediend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz za pomocą Option + ↑/↓ wyjście sterowane klawiszami głośności."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирати вихід, яким керують клавіші гучності, сполученням Option + ↑/↓."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses tuşlarının kontrol ettiği çıkışı Option + ↑/↓ ile seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Option + ↑/↓ 选择由音量键控制的输出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Option + ↑/↓ で音量キーが操作する出力を選択します。"
          }
        },
        "ko": {
