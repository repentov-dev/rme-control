            "value": "Ihre Auswahl wird für das nächste Mal gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix seront mémorisés pour la prochaine fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elecciones se recordarán la próxima vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte verranno ricordate la prossima volta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas escolhas serão lembradas da próxima vez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes worden de volgende keer onthouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wybory zostaną zapamiętane na następny raz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вибір запам'ятається наступного разу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimleriniz bir dahaki sefere hatırlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的选择会被记住，下次无需重选。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容は次回のために記憶されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항은 다음에 기억됩니다."
          }
        }
      }
    },
