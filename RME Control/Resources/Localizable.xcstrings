    "Show the Room EQ button on outputs. It opens the nine-band Room EQ of that output.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Room-EQ-Schaltfläche an Ausgängen. Sie öffnet den Neunband-Room-EQ des Ausgangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el botón Room EQ en las salidas. Abre el EQ de sala de nueve bandas de esa salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le bouton Room EQ sur les sorties. Il ouvre l'EQ de pièce à neuf bandes de cette sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il pulsante Room EQ sulle uscite. Apre l'EQ ambiente a nove bande di quell'uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力にルームEQボタンを表示します。その出力の9バンドルームEQが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력에 룸 EQ 버튼을 표시합니다. 해당 출력의 9밴드 룸 EQ가 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de Room EQ-knop bij uitgangen. Opent de ruimte-EQ met negen banden van die uitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje przycisk Room EQ na wyjściach. Otwiera dziewięciopasmowy EQ pomieszczenia tego wyjścia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o botão Room EQ nas saídas. Abre o EQ da sala de nove bandas dessa saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает кнопку Room EQ у выходов. Открывает девятиполосный Room EQ этого выхода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
