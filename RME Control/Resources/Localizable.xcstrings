            "value": "Te kanały będą dostępne w panelu paska menu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці канали будуть доступні в панелі рядка меню."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kanallar menü çubuğu panelinde kullanılabilir olacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
