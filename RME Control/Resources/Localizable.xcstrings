    "These channels will be available in the menu bar panel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти каналы будут доступны в панели из строки меню."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kanäle stehen im Menüleisten-Panel zur Verfügung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces canaux seront disponibles dans le panneau de la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos canales estarán disponibles en el panel de la barra de menús."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi canali saranno disponibili nel pannello della barra dei menu."
          }
        },
        "pt": {
