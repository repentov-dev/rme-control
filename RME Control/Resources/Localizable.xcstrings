    "The web remote works in any browser on the same Wi-Fi network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-пульт работает в любом браузере в той же сети Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Web-Remote funktioniert in jedem Browser im selben Wi-Fi-Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La télécommande Web fonctionne dans n'importe quel navigateur sur le même réseau Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control remoto web funciona en cualquier navegador en la misma red Wi-Fi."
          }
        },
        "it": {
