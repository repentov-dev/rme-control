    "Target −30…−10 dBFS, aim around −18 dBFS. Peaks should stay below −6.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель −30…−10 dBFS, ориентир около −18 dBFS. Пики должны быть ниже −6."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel −30…−10 dBFS, angepeilt etwa −18 dBFS. Spitzen sollten unter −6 bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cible −30…−10 dBFS, viser autour de −18 dBFS. Les crêtes doivent rester sous −6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo −30…−10 dBFS, apuntar a unos −18 dBFS. Los picos deben quedar por debajo de −6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Target −30…−10 dBFS, punta a circa −18 dBFS. I picchi dovrebbero restare sotto −6."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alvo −30…−10 dBFS, apontar para cerca de −18 dBFS. Os picos devem ficar abaixo de −6."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doel −30…−10 dBFS, mik op ongeveer −18 dBFS. Pieken moeten onder −6 blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel −30…−10 dBFS, dąż do około −18 dBFS. Szczyty powinny pozostać poniżej −6."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціль −30…−10 dBFS, орієнтуйтеся на −18 dBFS. Піки мають бути нижче −6."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef −30…−10 dBFS, yaklaşık −18 dBFS'i hedefleyin. Tepe değerler −6'nın altında kalmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标 −30…−10 dBFS，建议约 −18 dBFS。峰值应低于 −6。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲット −30…−10 dBFS、目安は −18 dBFS 付近。ピークは −6 未満に保ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 −30…−10 dBFS, 약 −18 dBFS를 목표로 하십시오. 피크는 −6 아래로 유지해야 합니다."
          }
        }
      }
    },
