        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это вернёт каналы, порты OSC и параметры отображения по умолчанию. Действие нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Standardkanäle, OSC-Ports und Anzeigeoptionen wiederhergestellt. Die Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela restaure les canaux par défaut, les ports OSC et les options d'affichage. L'action ne peut pas être annulée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaura los canales predeterminados, los puertos OSC y las opciones de visualización. La acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò ripristina i canali predefiniti, le porte OSC e le opzioni di visualizzazione. L'azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso restaura os canais padrão, portas OSC e opções de exibição. A ação não pode ser desfeita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdoor worden de standaardkanalen, OSC-poorten en weergaveopties hersteld. De actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to przywrócenie domyślnych kanałów, portów OSC i opcji wyświetlania. Czynności nie można cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відновлює стандартні канали, порти OSC і параметри відображення. Дію не можна скасувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, varsayılan kanalları, OSC bağlantı noktalarını ve görüntüleme seçeneklerini geri yükler. İşlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将恢复默认通道、OSC 端口和显示选项。该操作无法撤消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、デフォルトのチャネル、OSC ポート、および表示オプションが復元されます。アクションを元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 기본 채널, OSC 포트 및 디스플레이 옵션이 복원됩니다. 작업은 취소할 수 없습니다."
          }
        }
      }
    },
