      }
    },
    "When switching outputs with Option + ↑/↓, mute all outputs except the selected one.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При переключении выхода через Option + ↑/↓ мьютить все выходы, кроме выбранного."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechseln mit Option + ↑/↓ alle Ausgänge außer dem ausgewählten stummschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors du changement de sortie avec Option + ↑/↓, couper toutes les sorties sauf celle sélectionnée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar de salida con Opción + ↑/↓, silencia todas las salidas excepto la seleccionada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando cambi uscita con Opzione + ↑/↓, disattiva tutte le uscite tranne quella selezionata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao mudar de saída com Option + ↑/↓, silencia todas as saídas exceto a selecionada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij wisselen met Option + ↑/↓ alle uitgangen behalve de geselecteerde dempen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy przełączaniu wyjścia przez Option + ↑/↓ wycisz wszystkie wyjścia poza wybranym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час перемикання виходу через Option + ↑/↓ вимикати звук на всіх виходах, крім вибраного."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Option + ↑/↓ ile çıkış değiştirirken seçili olan dışındaki tüm çıkışları sessize al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Option + ↑/↓ 切换输出时，静音除所选输出外的所有输出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Option + ↑/↓ で出力を切り替えるとき、選択した出力以外をすべてミュートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option + ↑/↓로 출력을 전환할 때 선택한 출력을 제외한 모든 출력을 음소거합니다."
          }
        }
      }
    },
