    "Each output is controlled over OSC. The levels address is derived from the channel number in the OSC address.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый выход управляется по OSC. Адрес индикатора уровня выводится из номера канала в OSC-адресе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Ausgang wird über OSC gesteuert. Die Ebenenadresse wird aus der Kanalnummer in der OSC-Adresse abgeleitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque sortie est contrôlée via OSC. L'adresse des niveaux est dérivée du numéro de canal dans l'adresse OSC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada salida se controla a través de OSC. La dirección de niveles se deriva del número de canal en la dirección OSC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni uscita è controllata tramite OSC. L'indirizzo dei livelli deriva dal numero del canale nell'indirizzo OSC."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada saída é controlada pelo OSC. O endereço dos níveis é derivado do número do canal no endereço OSC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke uitgang wordt bestuurd via OSC. Het niveauadres wordt afgeleid van het kanaalnummer in het OSC-adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde wyjście jest sterowane poprzez OSC. Adres poziomów jest wyprowadzany z numeru kanału w adresie OSC."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен вихід контролюється через OSC. Адреса рівнів виводиться з номера каналу в адресі OSC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çıkış OSC üzerinden kontrol edilir. Seviye adresi OSC adresindeki kanal numarasından türetilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个输出都通过 OSC 进行控制。级别地址源自 OSC 地址中的通道号。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各出力はOSCで制御されます。レベル アドレスは、OSC アドレスのチャネル番号から導出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 출력은 OSC를 통해 제어됩니다. 레벨 주소는 OSC 주소의 채널 번호에서 파생됩니다."
          }
        }
      }
    },
