    "Welcome to RME Control": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в RME Control"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei RME Control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans RME Control"
          }
        },
