        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути звук вибраного виходу або перемкнути Dim — див. апаратні клавіші нижче."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili çıkışı sessize al veya Dim'i aç/kapat — aşağıdaki donanım tuşlarına bakın."
